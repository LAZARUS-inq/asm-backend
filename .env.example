# Database
DATABASE_URL=postgresql://asm:asm_secret@db:5432/asm_db

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Auth
SECRET_KEY=change-me-to-a-random-64-char-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Shodan (optional for week 3)
SHODAN_API_KEY=

# Scanners (optional — defaults shown)
NUCLEI_SUBPROCESS_TIMEOUT=600
NUCLEI_REQUEST_TIMEOUT=15
SCAN_TASK_SOFT_TIME_LIMIT=1200
SCAN_TASK_TIME_LIMIT=1260
NUCLEI_SCAN_MODE=tags
NUCLEI_SCAN_TAGS=sqli,xss,lfi,exposure,misconfig
NUCLEI_FALLBACK_TARGETS=http
NUCLEI_AUTOMATIC_SCAN=true
NUCLEI_SEVERITY=info,low,medium,high,critical

# App
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173
